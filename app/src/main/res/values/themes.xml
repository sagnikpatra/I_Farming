<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Compose owns all real UI; this only sets the
         window background/status bar so there's no flash of an unthemed screen
         before Compose content attaches. -->
    <style name="Theme.IFarming" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/saffron</item>
        <item name="colorPrimaryVariant">@color/saffron_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/field_green</item>
        <item name="colorSecondaryVariant">@color/field_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/field_green_dark</item>
        <item name="android:windowBackground">@color/cream_bg</item>
    </style>
</resources>
